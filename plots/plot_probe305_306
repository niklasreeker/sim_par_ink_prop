def sample_sd(values):
    return float(np.std(values,ddof=1)) if len(values)>1 else np.nan


def composition(pigment: float, ipa: float) -> np.ndarray:
    """Mass percentages; 'al' in InkCalculator denotes encapsulated pigment."""
    pg, mg = 2. * pigment, MG_PER_PIGMENT * pigment
    return np.array([pigment, ipa, pg, mg, 100. - pigment - ipa - pg - mg])


def find_repo(explicit: Path | None) -> Path:
    candidates = [explicit] if explicit else [
        *Path(__file__).resolve().parents, Path.cwd(), *Path.cwd().parents
    ]
    for candidate in candidates:
        if candidate is not None and (candidate / "ink_calculator.py").is_file():
            return candidate.resolve()
    raise FileNotFoundError("ink_calculator.py nicht gefunden. Skript in den Repository-Ordner legen oder --repo-root PFAD angeben.")


def load_calculator(repo: Path):
    # Use the actual local repository implementation, not copied formulas.
    sys.path.insert(0, str(repo))
    spec = importlib.util.spec_from_file_location("probe305_ink_calculator", repo / "ink_calculator.py")
    if spec is None or spec.loader is None:
        raise ImportError("Ink Calculator kann nicht geladen werden.")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module.InkCalculator(tables_dir=str(repo / "tables_parameters"))


class CalibrationField:
    """Saved scaled IDW or Gaussian field, with per-property quality weights.

    Implements idw_residual() from residual_calibration_field.py without
    importing that script's unrelated CLI/data-file dependencies.
    """
    def __init__(self, path: Path, repo: Path):
        self.model = json.loads(path.read_text(encoding="utf-8"))
        if self.model.get("schema") != "ink-residual-calibration-field":
            raise ValueError("Unbekanntes Kalibrierfeldformat.")
        provenance = self.model.get("calculator", {})
        hashes = {repo / "ink_calculator.py": provenance.get("sha256")}
        hashes.update({repo / "tables_parameters" / name: value
                       for name, value in provenance.get("table_sha256", {}).items()})
        for file, expected in hashes.items():
            # Git checkouts can change CRLF/LF without changing the model data.
            raw = file.read_bytes()
            lf = raw.replace(b"\r\n", b"\n")
            equivalent_hashes = {hashlib.sha256(data).hexdigest()
                                 for data in [raw, lf, lf.replace(b"\n", b"\r\n"),
                                              lf.rstrip()+b"\n", (lf.rstrip()+b"\n").replace(b"\n",b"\r\n")]}
            if expected and expected not in equivalent_hashes:
                # The repository changed only InkCalculator's __main__ demo.
                # Accept that known source only if ALL code outside that block
                # matches the verified training implementation's AST fingerprint.
                if file.name == "ink_calculator.py" and expected == "cc8fb9bf7c9c1c018a266fd8e6dd1287c63ce28dadd41ffebef75a63120b43b8":
                    tree = ast.parse(lf.decode("utf-8"))
                    tree.body = [node for node in tree.body if not (
                        isinstance(node,ast.If) and isinstance(node.test,ast.Compare)
                        and ast.dump(node.test,include_attributes=False) == ast.dump(
                            ast.parse("__name__ == '__main__'",mode="eval").body,include_attributes=False))]
                    # Python 3.12 adds empty type_params fields; normalize these
                    # so the fingerprint also works on supported Python 3.10/3.11.
                    code = ast.dump(tree,include_attributes=False).replace(", type_params=[]", "")
                    code_hash = hashlib.sha256(code.encode()).hexdigest()
                    if code_hash == "8fdf806dc6cf099c96e063a8d6efdd686cf47070f89b19c4100b05fc2beb47f3":
                        continue
                raise ValueError(f"Kalibrierfeld passt nicht zur aktuellen Datei {file.name}. Feld neu erstellen oder --no-field verwenden.")
        self.axes = self.model.get("composition_axes", ["Al_wt_pct", "IPA_wt_pct", "PG_wt_pct"])
        self.nodes = pd.DataFrame(self.model["nodes"])
        self.coordinates = self.nodes[self.axes].to_numpy(float)
        self.scale = np.asarray(self.model["interpolation"]["scale"], dtype=float)
        if self.scale.shape != (len(self.axes),) or np.any(self.scale <= 0):
            raise ValueError("Ungültige Skalierung im Kalibrierfeld.")

    def residual(self, comp: np.ndarray) -> np.ndarray:
        lookup = dict(zip(["Al_wt_pct", "IPA_wt_pct", "PG_wt_pct", "MG_wt_pct"], comp[:4]))
        target = np.array([lookup[axis] for axis in self.axes])
        distances = np.linalg.norm((self.coordinates - target) / self.scale, axis=1)
        if self.model["interpolation"].get("method") == "scaled_gaussian_kernel_regression":
            bandwidth = float(self.model["interpolation"]["bandwidth"])
            if bandwidth <= 0:
                raise ValueError("Ungültige Gauß-Bandbreite.")
            sq = distances**2
            log_geometry = -.5*(sq-sq.min())/bandwidth**2
            output=[]
            for val_col,se_col in [("A_Rho_kg_m3","A_Rho_SE_kg_m3"),("A_C_m_s","A_C_SE_m_s")]:
                se=pd.to_numeric(self.nodes[se_col],errors="coerce").to_numpy(float)
                good=se[np.isfinite(se)&(se>=0)]
                fallback=float(np.median(good)) if len(good) else 1.
                se=np.where(np.isfinite(se)&(se>=0),se,fallback)
                log_weights=log_geometry-2*np.log(np.maximum(se,max(fallback*.25,1e-9)))
                weights=np.exp(log_weights-log_weights.max());weights/=weights.sum()
                output.append(float(weights@self.nodes[val_col].to_numpy(float)))
            return float(self.model.get("calibration_strength",1.))*np.array(output)
        if self.model["interpolation"].get("method") != "scaled_inverse_distance_weighting":
            raise ValueError("Nicht unterstützte Kalibrierfeld-Interpolation.")
        requested = int(self.model["interpolation"].get("neighbors", 4))
        count = len(distances) if requested <= 0 else min(requested, len(distances))
        indexes = np.argsort(distances)[:count]
        if distances[indexes[0]] < 1e-12:
            indexes = indexes[:1]
            geometric = np.ones(1)
        else:
            power = float(self.model["interpolation"].get("power", 2.))
            geometric = 1. / np.maximum(distances[indexes], 1e-12) ** power
        output = []
        for value_col, se_col in [("A_Rho_kg_m3", "A_Rho_SE_kg_m3"), ("A_C_m_s", "A_C_SE_m_s")]:
            values = self.nodes[value_col].to_numpy(float)[indexes]
            se = pd.to_numeric(self.nodes[se_col], errors="coerce").to_numpy(float)[indexes]
            good = se[np.isfinite(se) & (se >= 0)]
            fallback = float(np.median(good)) if len(good) else 1.
            se = np.where(np.isfinite(se) & (se >= 0), se, fallback)
            weights = geometric / np.maximum(se, max(fallback * .25, 1e-9)) ** 2
            weights /= weights.sum()
            output.append(float(weights @ values))
        return np.array(output)

    def outside_axes(self, comp: np.ndarray) -> list[str]:
        lookup = dict(zip(["Al_wt_pct", "IPA_wt_pct", "PG_wt_pct", "MG_wt_pct"], comp[:4]))
        return [axis for j, axis in enumerate(self.axes)
                if lookup[axis] < self.coordinates[:, j].min() - 1e-10
                or lookup[axis] > self.coordinates[:, j].max() + 1e-10]


def properties(calculator, comp: np.ndarray, temperature: float, field=None) -> np.ndarray:
    arguments = dict(zip(["al", "ipa", "pg", "mg"], comp[:4]))
    result = np.array([1000. * calculator.density(**arguments, temperature=temperature),
                       calculator.sound_velocity(**arguments, temperature=temperature)])
    return result if field is None else result + field.residual(comp)


def invert(calculator, points: list[dict], field=None, *, anchor_recipe=True) -> tuple[np.ndarray, np.ndarray]:
    if anchor_recipe:
        offset = np.array([points[0]["rho"], points[0]["sound"]]) - properties(
            calculator, STANDARD, points[0]["temperature"], field)
        states = [STANDARD.copy()]  # P1 fixes the offset; it is not an independent prediction.
        selected_points = points[1:]
    else:
        offset = np.zeros(2)
        states = []
        selected_points = points
    for point in selected_points:
        target = np.array([point["rho"], point["sound"]]) - offset
        def residual(values):
            return (properties(calculator, composition(*values), point["temperature"], field) - target) / [.1, 1.]
        # Multiple starting values also detect discontinuities at IDW neighbors.
        solutions = [least_squares(residual, [al, ipa], bounds=([.8, 0.], [4., 8.]),
                                  xtol=1e-11, ftol=1e-11, gtol=1e-11)
                     for al in [1.7, 2., 2.4, 3.] for ipa in [.1, 1., 2., 3.5, 4.5]]
        best = min(solutions, key=lambda result: np.linalg.norm(result.fun))
        physical_residual = properties(calculator, composition(*best.x), point["temperature"], field) - target
        if np.max(np.abs(physical_residual)) > 1e-4:
            raise ValueError(f"Keine genaue gemeinsame Lösung für {point['name']}: Restfehler {physical_residual}. Keine Näherung wird als exakte Rückrechnung ausgegeben.")
        states.append(composition(*best.x))
    return np.array(states), offset


def read_sensor_csv(path: Path, points: list[dict]) -> None:
    frame = pd.read_csv(path, sep=None, engine="python", encoding="utf-8-sig")
    required = {"Date", "ProbeNr", "Rho_M", "C_M", "T_M"}
    required |= {"SensOK","Rho_S","C_S","C_Sp"} if ACTIVE_PROBE in (308,309) else {"Gueltig"}
    if not required.issubset(frame.columns):
        raise ValueError(f"CSV-Spalten fehlen: {sorted(required - set(frame.columns))}")
    for col in required - {"Date"}:
        frame[col] = pd.to_numeric(frame[col].astype(str).str.replace(",", ".", regex=False), errors="coerce")
    if {"Deutsche Zeit", "UTC Offset"}.issubset(frame.columns):
        text = frame["Date"].astype(str) + " " + frame["Deutsche Zeit"].astype(str) + " " + frame["UTC Offset"].astype(str)
        frame["local"] = pd.to_datetime(text, format="mixed", utc=True).dt.tz_convert("Europe/Berlin")
    elif "UTC Time" in frame.columns:
        text = frame["Date"].astype(str) + " " + frame["UTC Time"].astype(str)
        frame["local"] = pd.to_datetime(text, format="mixed", utc=True).dt.tz_convert("Europe/Berlin")
    else:
        raise ValueError("CSV benötigt UTC Time oder Deutsche Zeit mit UTC Offset.")
    for point in points:
        start = pd.Timestamp(f"{DATE} {point['start']}", tz="Europe/Berlin")
        end = pd.Timestamp(f"{DATE} {point['end']}", tz="Europe/Berlin")
        quality = ((frame.SensOK == 1) & (frame.C_M >= 1500) & (frame.Rho_S < .15)
                   & (frame.C_S < 1.5) & (frame.C_Sp < 5)) if ACTIVE_PROBE in (308,309) else frame.Gueltig == 1
        selected = frame[(frame.ProbeNr == ACTIVE_PROBE) & quality
                         & (frame.local >= start) & (frame.local < end)].dropna(subset=["Rho_M", "C_M", "T_M"]).sort_values("local")
        if len(selected) < 2:
            raise ValueError(f"Zu wenige gültige Messungen für {point['name']} im Fenster {point['start']}-{point['end']}.")
        for col, key in [("Rho_M", "rho"), ("C_M", "sound")]:
            point[key] = float(selected[col].mean())
            point[key + "_sd"] = float(selected[col].std(ddof=1))
        point["temperature"] = float(selected.T_M.mean())
        point["n"] = len(selected)
        centre = selected.local.min() + (selected.local.max() - selected.local.min()) / 2
        point["centre"] = centre.strftime("%H:%M:%S.%f")


def timestamp(time: str):
    # Naive datetimes here already represent local times, avoiding timezone tick shifts.
    return pd.Timestamp(f"{DATE} {time}").to_pydatetime()


def time_axis(axis, times, labels=None):
    if ACTIVE_PROBE in (308,309) and labels is None and len(times)>7:
        axis.xaxis.set_major_locator(mdates.AutoDateLocator(minticks=4,maxticks=7))
        axis.xaxis.set_major_formatter(mdates.DateFormatter("%H:%M"))
    else:
        axis.set_xticks(times)
        axis.set_xticklabels(labels if labels is not None else [time.strftime("%H:%M") for time in times])
    if ACTIVE_PROBE in (308,309) and labels is not None:
        for label in axis.get_xticklabels():
            label.set_rotation(25);label.set_ha("right");label.set_fontsize(9)
    axis.set_xlabel(f"Uhrzeit am {pd.Timestamp(DATE):%d.%m.%Y} (MESZ)")
    axis.grid(True, alpha=.3)
    axis.margins(x=.08)


def create_plots(calculator, points, states, hybrid, output: Path, formats, show: bool,
                 field_states_without_offset=None, defer_show=False):
    plt.style.use("default")  # Normal Matplotlib design: no theme or custom typography.
    output.mkdir(parents=True, exist_ok=True)
    figures = []
    def save(figure, name):
        figure.canvas.manager.set_window_title(f"Probe {ACTIVE_PROBE} - {name}")
        prefix = f"Probe {ACTIVE_PROBE} – "
        suptitle = getattr(figure, "_suptitle", None)
        if suptitle is not None and not suptitle.get_text().startswith(prefix):
            suptitle.set_text(prefix + suptitle.get_text())
        for axis in figure.axes:
            title = axis.get_title()
            if title and not title.startswith(prefix):
                axis.set_title(prefix + title)
        figure.tight_layout()
        for extension in formats:
            destination = output / f"{name}.{extension}"
            temporary = output / f".{name}_tmp.{extension}"
            figure.savefig(temporary, dpi=300, bbox_inches="tight")
            if temporary.stat().st_size == 0:
                raise ValueError(f"Leere Diagrammdatei: {destination.name}")
            temporary.replace(destination)
        figures.append(figure)
    sensor_times = [timestamp(p["centre"]) for p in points]
    rho = np.array([p["rho"] for p in points])
    sound = np.array([p["sound"] for p in points])
    temperatures = np.array([p["temperature"] for p in points])
    reference = float(temperatures.mean())  # Equal weight per point, not per minute row.
    correction = np.array([properties(calculator, state, reference) - properties(calculator, state, temp)
                           for state, temp in zip(states, temperatures)])
    normalized = np.column_stack([rho, sound]) + correction

    fig, ax = plt.subplots(figsize=(8, 4.8))
    tank_rows=tank_series(points)
    times = [timestamp(row[0]) for row in tank_rows]
    tank = np.array([row[1] for row in tank_rows]); samples = np.array([row[2] for row in tank_rows])
    loss = tank[0] - tank - samples
    ax.plot(times, loss, "o-", label="Verlust ohne Probenentnahmen")
    ax.plot(times, tank[0] - tank, "o--", label="Tankverlust einschließlich Proben")
    ax.set(title="Massenverlust des Tanks", ylabel="Kumulativer Massenverlust [g]")
    time_axis(ax, times)
    if ACTIVE_PROBE in (308,309):
        duration=(times[-1]-times[0]).total_seconds()/3600
        ax.text(.03,.95,f"Mittlerer bereinigter Verlust: {loss[-1]/duration:.1f} g/h",
                transform=ax.transAxes,va="top")
        ax.legend(loc="lower right")
    else:
        ax.legend()
    save(fig, "01_Massenverlust")

    def sensor_plot(values, title, name, compare_raw=False):
        fig, axes = plt.subplots(2, 1, figsize=(8, 6), sharex=True)
        for j, (ax, key, label) in enumerate(zip(axes, ["rho", "sound"], ["Dichte [kg/m³]", "Schallgeschwindigkeit [m/s]"])):
            if compare_raw:
                ax.plot(sensor_times, [p[key] for p in points], "o--", color="0.6", label="Unkorrigiert")
            ax.errorbar(sensor_times, values[:, j], yerr=[p[key + "_sd"] for p in points], fmt="o-", capsize=3,
                        label="Temperaturkorrigiert" if compare_raw else "Mittelwert ± s")
            diagnostic=[i for i,p in enumerate(points) if p.get("diagnostic")]
            if diagnostic:
                ax.plot([sensor_times[i] for i in diagnostic],values[diagnostic,j],"x",color="red",
                        markersize=8,label="Nach Pumpenänderung (diagnostisch)")
            ax.set_ylabel(label); time_axis(ax, sensor_times); ax.legend()
        axes[0].set_xlabel("")
        fig.suptitle(title)
        save(fig, name)
    sensor_plot(np.column_stack([rho, sound]), "Dichte und Schallgeschwindigkeit", "02_Dichte_Schallgeschwindigkeit")

    fig, ax = plt.subplots(figsize=(8, 4.8))
    labs=lab_series(points)
    times = [timestamp(row[1]) for row in labs]
    dry = np.array([np.mean(row[2]) for row in labs])
    sd = np.array([sample_sd(row[2]) for row in labs])
    ax.errorbar(times, dry, yerr=sd, fmt="o-", capsize=3, label="Festkörpergehalt ± s")
    if ACTIVE_PROBE == 305:
        ax.plot(times[0], dry[0], "x", color="red", markersize=8, label="P1: auffällige Messung")
    elif ACTIVE_PROBE == 306:
        ax.errorbar(timestamp("10:27"), np.mean([2.04, 2.11]),
                    yerr=np.std([2.04, 2.11], ddof=1), fmt="s", capsize=3,
                    label="Eimer vor Befüllen ± s")
    if ACTIVE_PROBE == 308:
        ax.plot(times[0],dry[0],"s",label="Eimer: akzeptierter Einzelwert 2,08 %")
    ax.axhline(STANDARD[0] + STANDARD[3], color="0.4", linestyle="--",
               label=f"Rezeptur: Pigment + MG ({STANDARD[0]+STANDARD[3]:.3f} %)")
    ax.set(title="Festkörpergehalt", ylabel="Festkörpergehalt [Masse-%]")
    time_axis(ax, [timestamp("10:27"), *times] if ACTIVE_PROBE == 306 else times); ax.legend()
    save(fig, "03_Festkoerpergehalt")

    fig, axes = plt.subplots(2, 1, figsize=(8, 6), sharex=True, gridspec_kw={"height_ratios": [2, 1]})
    for j, label in enumerate(COMPONENTS[:4]):
        line, = axes[0].plot(sensor_times, states[:, j], "o-", label=label)
        if hybrid is not None:
            axes[0].plot(sensor_times, hybrid[:, j], "--", color=line.get_color())
    axes[0].set(ylabel="Pigment, IPA, PG, MG [Masse-%]", title="Formale Rückrechnung aus Dichte und Schall", ylim=(0, 6))
    handles, labels = axes[0].get_legend_handles_labels()
    if hybrid is not None:
        handles.append(Line2D([], [], color="black", linestyle="--"))
        labels.append("Kalibrierfeld (gestrichelt)")
    axes[0].legend(handles, labels, ncol=2)
    axes[1].plot(sensor_times, states[:, 4], "o-", label="Wasser")
    if hybrid is not None:
        axes[1].plot(sensor_times, hybrid[:, 4], "--", label="Wasser: Kalibrierfeld")
    axes[1].set_ylabel("Wasser [Masse-%]"); axes[1].legend()
    ratio = states[:, [1, 4]] / states[:, [0]]
    flags = [False] + [bool(np.any(ratio[i] > ratio[0] + 1e-8)
                                  or np.any(ratio[i] > ratio[i - 1] + 1e-8)) for i in range(1, len(points))]
    point_labels = [(p["name"].split("_")[0] if p.get("diagnostic") else p["name"]) + (" [P]" if p.get("diagnostic") else "") + ("*" if flag else "") + "\n" + time.strftime("%H:%M")
                    for p, time, flag in zip(points, sensor_times, flags)]
    for ax in axes:
        time_axis(ax, sensor_times, point_labels)
    axes[1].set_xlabel(f"Uhrzeit am {pd.Timestamp(DATE):%d.%m.%Y} (MESZ)"
                      + ("; *: Bilanzabweichung" if any(flags) else "")
                      + ("; [P]: nach Pumpenänderung" if any(p.get("diagnostic") for p in points) else ""))
    axes[0].set_xlabel("")
    save(fig, "04_Rueckgerechnete_Zusammensetzung")

    sensor_plot(normalized, f"Dichte und Schall, korrigiert auf {reference:.3f} °C", "05_Dichte_Schall_temperaturkorrigiert", compare_raw=True)
    # Error bars in the corrected plot retain the ORIGINAL within-window SD.
    # They do not include uncertainty of the model, the inferred composition or T.
    if field_states_without_offset is not None:
        direct = field_states_without_offset
        fig, axes = plt.subplots(2, 1, figsize=(8, 6), sharex=True,
                                 gridspec_kw={"height_ratios": [2, 1]})
        for j, label in enumerate(COMPONENTS[:4]):
            axes[0].plot(sensor_times, direct[:, j], "o-", label=label)
        axes[0].set(ylabel="Pigment, IPA, PG, MG [Masse-%]",
                    title="Rückrechnung mit Kalibrierfeld\nOhne zusätzlichen Sensoroffset",
                    ylim=(0, max(6., float(np.max(direct[:, :4])) * 1.1)))
        axes[0].legend(ncol=2)
        axes[1].plot(sensor_times, direct[:, 4], "o-", label="Wasser")
        axes[1].set_ylabel("Wasser [Masse-%]")
        axes[1].legend()
        ratios = direct[:, [1, 4]] / direct[:, [0]]
        flags = [False] + [bool(np.any(ratios[i] > ratios[0] + 1e-8)
                               or np.any(ratios[i] > ratios[i - 1] + 1e-8))
                           for i in range(1, len(points))]
        labels = [(point["name"].split("_")[0] if point.get("diagnostic") else point["name"]) + (" [P]" if point.get("diagnostic") else "") + ("*" if flag else "") + "\n" + time.strftime("%H:%M")
                  for point, time, flag in zip(points, sensor_times, flags)]
        for ax in axes:
            time_axis(ax, sensor_times, labels)
        axes[0].set_xlabel("")
        axes[1].set_xlabel(f"Uhrzeit am {pd.Timestamp(DATE):%d.%m.%Y} (MESZ)"
                          + ("; *: Bilanzabweichung" if any(flags) else "")
                          + ("; [P]: nach Pumpenänderung" if any(p.get("diagnostic") for p in points) else ""))
        save(fig, "06_Zusammensetzung_Kalibrierfeld_ohne_Offset")
    summary = pd.DataFrame({"Punkt": [p["name"] for p in points], "T_C": temperatures,
                            "Rho_roh_kg_m3": rho, "C_roh_m_s": sound,
                            "Delta_Rho_T_kg_m3": correction[:, 0], "Delta_C_T_m_s": correction[:, 1],
                            "Rho_Tref_kg_m3": normalized[:, 0], "C_Tref_m_s": normalized[:, 1]})
    print(f"\nReferenztemperatur (Mittel der {len(points)} Sensorpunkte): {reference:.9f} °C")
    print(summary.to_string(index=False, float_format=lambda v: f"{v:.6f}"))
    print("Fehlerbalken: ursprüngliche Fensterstreuung, keine gesamte Modell-/Korrekturunsicherheit.")
    export_tables(points, states, hybrid, field_states_without_offset, summary, output)
    print(f"\nDiagramme gespeichert in: {output.resolve()}")
    if show and not defer_show:
        plt.show()
    if not defer_show:
        for fig in figures:
            plt.close(fig)
    return reference, normalized


def export_tables(points, states, hybrid, direct, temperature_summary, output):
    """Export auditable point summaries and rates; sampling times stay separate."""
    rows = []
    for p in points:
        rows.append(dict(Punkt=p["name"], ProbeNr=ACTIVE_PROBE, Datum=DATE,
                         Probennahme=p.get("sample"), Tankwiegezeit=p.get("tank_time"),
                         Sensorfenster_Start=p["start"], Sensorfenster_Ende_exklusiv=p["end"],
                         Sensor_Mitte=p["centre"], n=p["n"],
                         Tank_g=p.get("tank_g",np.nan), Proben_seit_P1_g=p.get("samples_g",np.nan),
                         Rho_kg_m3=p["rho"], Rho_SD_kg_m3=p["rho_sd"],
                         C_m_s=p["sound"], C_SD_m_s=p["sound_sd"], T_C=p["temperature"],
                         Diagnostisch_nach_Pumpenaenderung=bool(p.get("diagnostic",False)),
                         Festkoerper_gemessen_pct=np.mean(p["dry"]) if p.get("dry") else np.nan,
                         Festkoerper_SD_pct=sample_sd(p.get("dry",[]))))
    pd.DataFrame(rows).to_csv(output / "messpunkte.csv", index=False, encoding="utf-8-sig")
    rates = []
    tank_rows=tank_series(points)
    for index,(previous,current) in enumerate(zip(tank_rows[:-1],tank_rows[1:]),1):
        minutes = (timestamp(current[0]) - timestamp(previous[0])).total_seconds() / 60.
        if minutes < 0:
            raise ValueError("Tankwiegezeiten müssen chronologisch sein.")
        tank_loss = previous[1] - current[1]
        sampling = current[2] - previous[2]
        loss = tank_loss - sampling
        label=(points[index-1]["name"]+"-"+points[index]["name"]) if ACTIVE_PROBE in (305,306) else str(index)
        rates.append(dict(Intervall=label,
                          Start=previous[0], Ende=current[0],
                          Dauer_min=minutes, Tankverlust_g=tank_loss, Probenverlust_g=sampling,
                          Bereinigter_Verlust_g=loss, Rate_g_h=loss*60./minutes if minutes else np.nan))
    pd.DataFrame(rates).to_csv(output / "verlustraten.csv", index=False, encoding="utf-8-sig")
    print("\nTankverlustraten, ohne Probenentnahmen (keine gesicherte Verdunstungsrate):")
    print(pd.DataFrame(rates).to_string(index=False, float_format=lambda v: f"{v:.3f}"))
    if ACTIVE_PROBE in (308,309):
        tank_frame=pd.DataFrame(tank_rows,columns=["Uhrzeit","Tank_g","Proben_seit_Start_g"])
        tank_frame["Bereinigter_Verlust_g"]=tank_rows[0][1]-tank_frame.Tank_g-tank_frame.Proben_seit_Start_g
        tank_frame.to_csv(output/"tankmessungen.csv",index=False,encoding="utf-8-sig")
        duration=(timestamp(tank_rows[-1][0])-timestamp(tank_rows[0][0])).total_seconds()/3600
        pd.DataFrame([dict(Start=tank_rows[0][0],Ende=tank_rows[-1][0],Dauer_h=duration,
             Bereinigter_Verlust_g=tank_frame.Bereinigter_Verlust_g.iloc[-1],
             Mittlerer_Verlust_g_h=tank_frame.Bereinigter_Verlust_g.iloc[-1]/duration)]).to_csv(
             output/"mittlerer_tankverlust.csv",index=False,encoding="utf-8-sig")
        pd.DataFrame([dict(Punkt=n,Probennahme=t,Ort=loc,Wiederholungen="/".join(map(str,vals)),
             Festkoerper_pct=np.mean(vals),SD_pct=sample_sd(vals),n=len(vals))
             for n,t,vals,loc in lab_series(points)]).to_csv(output/"festkoerper_messungen.csv",index=False,encoding="utf-8-sig")
    temperature_summary.to_csv(output / "temperaturkorrektur.csv", index=False, encoding="utf-8-sig")
    compositions, comparison = [], []
    for method, values in [("Calculator_mit_P1_Offset", states),
                           ("Kalibrierfeld_mit_P1_Offset", hybrid),
                           ("Kalibrierfeld_ohne_Offset_Plot6", direct)]:
        if values is None:
            continue
        for point, comp in zip(points, values):
            compositions.append(dict(Punkt=point["name"], Methode=method,
                                     Pigment_pct=comp[0], IPA_pct=comp[1], PG_pct=comp[2],
                                     MG_pct=comp[3], Wasser_pct=comp[4]))
            calculated = comp[0] + comp[3]
            measured = float(np.mean(point["dry"])) if point.get("dry") else np.nan
            comparison.append(dict(Punkt=point["name"], Methode=method,
                                   Festkoerper_gemessen_pct=measured,
                                   Festkoerper_berechnet_pct=calculated,
                                   Differenz_gemessen_minus_berechnet_Prozentpunkte=measured-calculated,
                                   Hinweis="Zeitlich getrennte MA160-Werte siehe festkoerper_messungen.csv" if not point.get("dry") else ""))
    pd.DataFrame(compositions).to_csv(output / "zusammensetzungen.csv", index=False, encoding="utf-8-sig")
    pd.DataFrame(comparison).to_csv(output / "festkoerpervergleich.csv", index=False, encoding="utf-8-sig")
    quality_note=("SensOK=1, C_M>=1500, Rho_S<0.15, C_S<1.5, C_Sp<5; gepaarte rho/c/T-Zeilen in luftarmen Fenstern."
                  if ACTIVE_PROBE in (308,309) else "Fensterende exklusiv; nur Gueltig=1 in ausgewählten luftarmen MTU-Pausen.")
    notes = [quality_note,
             "Fenster-SD ist keine vollständige Mess- oder Modellunsicherheit.",
             "Plot 4: Calculator und Kalibrierfeld mit separatem P1-Rezepturanker.",
             "Plot 6: alle Punkte unabhängig mit Kalibrierfeld, ohne zusätzlichen Offset.",
             "Probenentnahmen ändern bei homogener Tinte die Zusammensetzung nicht unmittelbar.",
             "Tankverlust kann Änderungen des Leitungsinventars enthalten."]
    notes += EXPERIMENTS[ACTIVE_PROBE].get("notes",[])
    if ACTIVE_PROBE in (308,309):
        notes += ["Sensor-/MA160-/Tankpunkte separat; keine künstliche zeitgleiche Paarung oder Interpolation.",
                  "P1-Rezepturanker bezeichnet hier S0 (erstes akzeptiertes Sensorfenster).",
                  "Gauß-Kalibrierfeld 9/10/11, gespeichertes alpha=0.70 und Bandbreite=0.30.",
                  "Gleiche dokumentierte Minute vor/nach Entnahme: Restverlust dargestellt, Intervallrate undefiniert."]
    if ACTIVE_PROBE == 306:
        notes += ["11:35 MTU Stopp im zweiten Zyklus vermutlich 13:35; nicht als bestätigte Zeit behandelt.",
                  "Probenmassen etwa 100, 85, 81, 93 g; Waagensprünge 145, 115, 80, 75 g.",
                  "P1 liegt nach der ersten 100-g-Probe; diese ist außerhalb des P1-P4-Verlusts.",
                  "Eimerverlust 09:34-10:27: 14.6 g in 53 min = 16.53 g/h; Verlust seit 09:25 unbekannt.",
                  "Eimer-Festkörper 2.04/2.11 %, Entnahmezeit nur dem Ende des Rührens zugeordnet.",
                  "Keine Nachfüllung dokumentiert; Leerlauf, kein Druckverbrauch angesetzt.",
                  "P4 Probe/Tank 15:25; Sensor 15:52-15:57. Kein zeitgleicher Vergleich."]
    (output / "auswertung_metadata.json").write_text(json.dumps(
        dict(probe=ACTIVE_PROBE, date=DATE, nominal_recipe_pct=dict(zip(COMPONENTS, STANDARD.tolist())),
             calibration_field_default=str(GAUSSIAN_FIELD_RELATIVE if ACTIVE_PROBE in (308,309) else FIELD_RELATIVE),
             calibration_field_used=ACTIVE_FIELD_INFO,
             notes=notes), ensure_ascii=False, indent=2), encoding="utf-8")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--repo-root", type=Path, help="Ordner mit ink_calculator.py und tables_parameters")
    parser.add_argument("--probe", choices=["305", "306", "308", "309", "all"], default="all",
                        help="Versuch auswählen; Standard: all (305, 306, 308 und 309)")
    parser.add_argument("--output-dir", type=Path, help="Standard: Skriptordner/results_ProbeNNN; bei all ein Unterordner je Probe")
    parser.add_argument("--csv", type=Path, help="Optional: Sensorfenster aus dieser Mess-CSV neu auswerten")
    parser.add_argument("--calibration-field", type=Path, help="Optional: anderes gespeichertes calibration_field.json")
    parser.add_argument("--no-field", action="store_true", help="Nur Ink Calculator verwenden")
    parser.add_argument("--no-show", action="store_true", help="Diagramme speichern, keine Fenster öffnen")
    parser.add_argument("--formats", nargs="+", choices=["png", "pdf", "svg"], default=["png"], help="Standard: png; z.B. --formats png pdf")
    args = parser.parse_args()
    for probe in ([305, 306, 308, 309] if args.probe == "all" else [int(args.probe)]):
        run_probe(args, probe)
    # Show only after both probes have finished; closing Probe 305 windows
    # must not be required before Probe 306 is calculated and saved.
    if not args.no_show:
        plt.show()
        plt.close("all")


def run_probe(args, probe):
    global DATE, STANDARD, MG_PER_PIGMENT, ACTIVE_PROBE, ACTIVE_FIELD_INFO
    ACTIVE_PROBE = probe
    ACTIVE_FIELD_INFO = None
    experiment = EXPERIMENTS[probe]
    DATE = experiment["date"]
    masses = np.array(experiment["masses"])
    STANDARD = masses / masses.sum() * 100.
    MG_PER_PIGMENT = masses[3] / masses[0]
    repo = find_repo(args.repo_root)
    calculator = load_calculator(repo)
    points = [dict(p, **({"dry":list(p["dry"])} if "dry" in p else {})) for p in experiment["points"]]
    print(f"\n=== Probe {probe}, {DATE} ===")
    if probe == 306:
        print("Protokoll: zweite Angabe '11:35 MTU Stopp' als 13:35 interpretiert.")
        print("Probenmassen ungefähr; Waagensprünge stimmen nicht exakt damit überein.")
        print("P1-Rezepturanker vernachlässigt Verluste vor P1; keine unabhängige Bestimmung des Offsets.")
        print("P4: Sensorfenster 15:52-15:57, Probe/Tankwaage 15:25; Zeitversatz beachten.")
    if args.csv:
        read_sensor_csv(args.csv, points)
    for note in experiment.get("notes",[]):
        print("HINWEIS:",note)
    states, offset = invert(calculator, points)
    print(f"Ink Calculator Offset: Dichte {offset[0]:+.6f} kg/m³, Schall {offset[1]:+.6f} m/s")
    print(pd.DataFrame(states, index=[p["name"] for p in points], columns=COMPONENTS).to_string(float_format=lambda v: f"{v:.6f}"))
    for i in range(1, len(states)):
        ratio = states[i, [1, 4]] / states[i, 0]
        if np.any(ratio > states[0, [1, 4]] / states[0, 0] + 1e-8) or np.any(ratio > states[i - 1, [1, 4]] / states[i - 1, 0] + 1e-8):
            print(f"HINWEIS {points[i]['name']}: Wasser/Pigment oder IPA/Pigment steigt gegenüber dem Start oder dem vorherigen Punkt. Die formale Rückrechnung verletzt die reine Verdunstungsannahme.")
    hybrid = None
    field_states_without_offset = None
    field_path = args.calibration_field or repo / (GAUSSIAN_FIELD_RELATIVE if probe in (308,309) else FIELD_RELATIVE)
    if not args.no_field and field_path.is_file():
        field = CalibrationField(field_path, repo)
        ACTIVE_FIELD_INFO = dict(path=str(field_path),method=field.model["interpolation"]["method"],
                                 strength=field.model.get("calibration_strength",1.),
                                 bandwidth=field.model["interpolation"].get("bandwidth"))
        hybrid, field_offset = invert(calculator, points, field)
        field_states_without_offset, _ = invert(calculator, points, field, anchor_recipe=False)
        print("\nPlot 6: punktweise Kalibrierfeld-Rückrechnung ohne zusätzlichen Sensoroffset")
        print(pd.DataFrame(field_states_without_offset, index=[p["name"] for p in points],
                           columns=COMPONENTS).to_string(float_format=lambda v: f"{v:.6f}"))
        ratios = field_states_without_offset[:, [1, 4]] / field_states_without_offset[:, [0]]
        for i, (point, comp) in enumerate(zip(points, field_states_without_offset)):
            outside = field.outside_axes(comp)
            if outside:
                print(f"HINWEIS Plot 6 {point['name']}: Kalibrierfeld außerhalb der Trainingsbereiche für {', '.join(outside)}.")
            if i and (np.any(ratios[i] > ratios[0] + 1e-8)
                      or np.any(ratios[i] > ratios[i - 1] + 1e-8)):
                print(f"HINWEIS Plot 6 {point['name']}: Bilanzabweichung; die punktweisen Lösungen bilden keinen reinen Verdunstungsverlauf.")
        print(f"Kalibrierfeld Offset: Dichte {field_offset[0]:+.6f} kg/m³, Schall {field_offset[1]:+.6f} m/s")
        for point, comp in zip(points, hybrid):
            outside = field.outside_axes(comp)
            if outside:
                print(f"HINWEIS {point['name']}: Kalibrierfeld außerhalb der Trainingsbereiche für {', '.join(outside)}.")
    elif args.calibration_field and not args.no_field:
        raise FileNotFoundError(field_path)
    elif not args.no_field:
        print("Kalibrierfeld nicht gefunden; Diagramm 4 verwendet nur den Ink Calculator.")
    if field_states_without_offset is None:
        print("Diagramm 6 wird ohne Kalibrierfeld nicht erstellt.")
    output = ((args.output_dir / f"Probe{probe}") if args.output_dir and args.probe == "all"
              else args.output_dir or Path(__file__).resolve().parent / f"results_Probe{probe}")
    create_plots(calculator, points, states, hybrid, output, args.formats, False,
                 field_states_without_offset=field_states_without_offset,
                 defer_show=not args.no_show)


if __name__ == "__main__":
    try:
        main()
    except (ValueError, FileNotFoundError, ImportError) as error:
        raise SystemExit(str(error)) from error

